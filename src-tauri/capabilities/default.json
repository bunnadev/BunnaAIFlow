{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "dialog:allow-ask",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "/Volumes/**"]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.vbee.vn/*" },
        { "url": "https://vbee.vn/*" }
      ]
    }
  ]
}
